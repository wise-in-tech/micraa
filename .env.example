# Copy this file to .env (same folder) and fill in your real values.
# .env is git-ignored - never commit real passwords/secrets.
#
# docker-compose automatically loads a sibling .env file and substitutes
# these into docker-compose.yml's `${VAR}` references.

# PostgreSQL (real server install, listening on the host's port 5432 -
# docker-compose reaches it via host.docker.internal, see docker-compose.yml)
DB_USERNAME=micraa_backend
DB_PASSWORD=change-me

# LiveKit (must match the `keys:` section in livekit.yaml)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me

# Google Sign-In (optional - leave empty to disable POST /api/auth/google).
# Comma-separated OAuth client IDs accepted as the ID token audience: the Web
# client ID (used as serverClientId by Android) and the iOS client ID.
GOOGLE_AUTH_CLIENT_IDS=
